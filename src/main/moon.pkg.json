{
  "is-main": true,
  "import": [
    "moon-release/src/lib/config",
    "moon-release/src/lib/conventional",
    "moon-release/src/lib/semver",
    "moon-release/src/lib/git",
    "moon-release/src/lib/github",
    "moon-release/src/lib/moon_mod",
    "moon-release/src/lib/executor",
    "moon-release/src/lib/workflow",
    "moon-release/src/lib/util",
    "TheWaWaR/clap",
    "moonbitlang/async",
    "moonbitlang/async/fs",
    "moonbitlang/async/io",
    "moonbitlang/core/json",
    "moonbitlang/core/env"
  ],
  "pre-build": [
    {
      "input": "../../moon.mod.json",
      "output": "version_info.mbt",
      "command": ":embed -i $input -o $output --name embedded_moon_mod_json"
    }
  ],
  "targets": {
    "main.mbt": ["native"],
    "completions.mbt": ["native"],
    "version_info.mbt": ["native"],
    "stub.mbt": ["wasm", "wasm-gc", "js"]
  }
}
