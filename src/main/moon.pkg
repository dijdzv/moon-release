import {
  "dijdzv/moon-release/src/lib/config",
  "dijdzv/moon-release/src/lib/conventional",
  "dijdzv/moon-release/src/lib/semver",
  "dijdzv/moon-release/src/lib/git",
  "dijdzv/moon-release/src/lib/moon_mod",
  "dijdzv/moon-release/src/lib/workflow",
  "dijdzv/moon-release/src/lib/util",
  "TheWaWaR/clap",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

options(
  "is-main": true,
  "native-stub": [ "exit_wrapper.c" ],
  "pre-build": [
    {
      "command": ":embed -i $input -o $output --name embedded_moon_mod_json",
      "input": "../../moon.mod.json",
      "output": "version_info.mbt",
    },
  ],
  targets: {
    "completions.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "stub.mbt": [ "wasm", "wasm-gc", "js" ],
    "version_info.mbt": [ "native" ],
  },
)